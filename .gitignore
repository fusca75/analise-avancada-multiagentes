# Publicação documental e arquivos estáticos para o Render.
*
!*/
!/.gitignore
!*.md
!**/*.md

# Ambientes locais, dependências e caches
.venv/
**/.venv/
venv/
**/node_modules/
**/__pycache__/
*.py[cod]

# Bases, saídas geradas e imagens pesadas
*.csv
*.json
*.png
*.jpg
*.jpeg
*.webp
*.pdf
*.log

# O dashboard estático e a configuração de deploy são publicados.
!projeto-dashboard/site/
!projeto-dashboard/site/**
!/render.yaml
